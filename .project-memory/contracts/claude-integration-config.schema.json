{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ClaudeIntegrationConfigV4",
  "title": "ClaudeIntegrationConfigV4",
  "type": "object",
  "required": ["version", "enabled", "homeMode", "manualHome", "managedReplies", "bypassPermissions", "replyTransport", "sendShortcut", "enabledAtMs", "desiredSessionIds", "readEventIds", "notifiedEventIds", "sessionPreferences"],
  "properties": {
    "version": { "const": 4 },
    "enabled": { "type": "boolean", "default": false },
    "homeMode": { "enum": ["auto", "manual"], "default": "auto" },
    "manualHome": { "type": "string", "maxLength": 1024 },
    "managedReplies": { "type": "boolean", "default": true },
    "bypassPermissions": { "type": "boolean", "default": false },
    "replyTransport": { "enum": ["direct", "desktop"], "default": "direct" },
    "sendShortcut": { "enum": ["enter", "ctrl-enter"], "default": "enter" },
    "enabledAtMs": { "type": "number", "minimum": 0 },
    "desiredSessionIds": { "$ref": "#/$defs/idList" },
    "readEventIds": { "$ref": "#/$defs/eventList" },
    "notifiedEventIds": { "$ref": "#/$defs/eventList" },
    "sessionPreferences": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": { "$ref": "#/$defs/sessionPreference" }
    }
  },
  "$defs": {
    "idList": { "type": "array", "items": { "type": "string", "maxLength": 240 }, "maxItems": 128, "uniqueItems": true },
    "eventList": { "type": "array", "items": { "type": "string", "maxLength": 240 }, "maxItems": 1024, "uniqueItems": true },
    "sessionPreference": {
      "type": "object",
      "required": ["thinkingMode", "effort"],
      "properties": {
        "thinkingMode": { "enum": ["auto", "inherit", "adaptive", "disabled"] },
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] }
      },
      "additionalProperties": false
    }
  },
  "x-status": "Confirmed except the adaptive mode, which is uncommitted work in src/shared/claude-integration.js",
  "x-evidence": "src/shared/claude-integration.js, tests/claude-integration.test.mjs"
}
