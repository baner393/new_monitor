{
  "name": "turtle-monitor",
  "productName": "Turtle Monitor",
  "version": "1.0.0",
  "description": "Turtle Monitor - Electron + PixiJS",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "electron-forge start",
    "build": "node scripts/build.mjs",
    "build:free": "cross-env VITE_EDITION=free node scripts/build.mjs",
    "build:sponsor": "cross-env VITE_EDITION=sponsor node scripts/build.mjs",
    "dist:free": "cross-env VITE_EDITION=free node scripts/build.mjs && electron-builder build --win --x64 --config electron-builder.config.js",
    "dist:sponsor": "cross-env VITE_EDITION=sponsor node scripts/build.mjs && electron-builder build --win --x64 --config electron-builder.config.js",
    "package": "electron-forge package",
    "package:free": "cross-env VITE_EDITION=free electron-forge package",
    "package:sponsor": "cross-env VITE_EDITION=sponsor electron-forge package",
    "make": "cross-env VITE_EDITION=free electron-forge make",
    "make:free": "cross-env VITE_EDITION=free electron-forge make",
    "make:sponsor": "cross-env VITE_EDITION=sponsor electron-forge make"
  },
  "author": "Turtle Monitor",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/plugin-vite": "^7.8.0",
    "cross-env": "^10.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "pixi.js": "^7.3.0"
  }
}
